# Copie para .env.local (no computador) e preencha. Na Vercel, cadastre as mesmas
# variáveis em Settings > Environment Variables. NUNCA publique os valores reais.
# Sem as variáveis do Supabase, o site roda em modo demonstração (dados de exemplo).

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# SECRETA: ignora as regras de segurança do banco. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Mercado Pago (Suas integrações > sua aplicação > Credenciais) ---
# Comece com o Access Token de TESTE (conta vendedora de teste). Depois troque pelo de produção.
MP_ACCESS_TOKEN=APP_USR-...
# Suas integrações > Webhooks > "Assinatura secreta"
MP_WEBHOOK_SECRET=...

# --- E-mail (resend.com > API Keys) ---
RESEND_API_KEY=re_...
# Remetente. Sem domínio verificado no Resend use: Loja <onboarding@resend.dev>
# (nesse caso o Resend só entrega para o e-mail da sua conta Resend)
EMAIL_REMETENTE=Loja Exemplo <pedidos@seudominio.com.br>

# --- Loja ---
# E-mail que recebe o aviso de pedido pago (com o link pronto para o WhatsApp do cliente)
LOJA_EMAIL=loja@seudominio.com.br
# WhatsApp da loja: DDI + DDD + número, só dígitos
LOJA_WHATSAPP=5573999999999
# Endereço público do site, sem barra no final (na Vercel, se vazio, usa o domínio .vercel.app)
SITE_URL=https://celular-kohl.vercel.app

# --- Lançamento ---
# Enquanto "true" (ou ausente), o site fica fora do Google e mostra aviso de testes no checkout
NEXT_PUBLIC_LOJA_EM_TESTES=true
